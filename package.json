{
  "name": "design50",
  "displayName": "Design50",
  "description": "Provide design suggestions for your code",
  "version": "1.0.0",
  "publisher": "CS50",
  "repository": "https://github.com/cs50/design50.vsix",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "design50.run",
        "title": "design50"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "design50.run",
          "group": "navigation@-50",
          "when": "(resourceExtname =~ /\\.(py|c|cpp|h|hpp|java|html|css|js)$/) && !isInDiffEditor"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "tall": "^8.0.0"
  }
}
